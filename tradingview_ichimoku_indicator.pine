//@version=5
indicator("Ichimoku Multi-Kijun Indicator", overlay=true)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// Basic Ichimoku Settings (9, 26, 52, 26)
tenkan_period = input.int(9, "Tenkan-sen Period", minval=1, group="Ichimoku Basic")
kijun_period = input.int(26, "Kijun-sen Period", minval=1, group="Ichimoku Basic")
senkou_span_b_period = input.int(52, "Senkou Span B Period", minval=1, group="Ichimoku Basic")
displacement = input.int(26, "Displacement", minval=1, group="Ichimoku Basic")

// Additional Kijun Periods
kijun_65_period = input.int(65, "Kijun 65 Period", minval=1, group="Additional Kijun")
kijun_129_period = input.int(129, "Kijun 129 Period", minval=1, group="Additional Kijun")
kijun_172_period = input.int(172, "Kijun 172 Period", minval=1, group="Additional Kijun")
kijun_234_period = input.int(234, "Kijun 234 Period", minval=1, group="Additional Kijun")

// SMMA Periods
smma_52_period = input.int(52, "SMMA 52 Period", minval=1, group="SMMA")
smma_139_period = input.int(139, "SMMA 139 Period", minval=1, group="SMMA")
smma_400_period = input.int(400, "SMMA 400 Period", minval=1, group="SMMA")

// Display Options
show_basic_ichimoku = input.bool(true, "Show Basic Ichimoku", group="Display")
show_additional_kijun = input.bool(true, "Show Additional Kijun", group="Display")
show_smma = input.bool(true, "Show SMMA", group="Display")
show_signals = input.bool(true, "Show Buy/Sell Signals", group="Display")

// ============================================================================
// CUSTOM FUNCTIONS
// ============================================================================

// Donchian Channel function (for Ichimoku lines)
donchian(length) =>
    math.avg(ta.lowest(low, length), ta.highest(high, length))

// SMMA (Smoothed Moving Average) function
smma(src, length) =>
    var float smma_val = na
    smma_val := na(smma_val) ? ta.sma(src, length) : (smma_val * (length - 1) + src) / length
    smma_val

// ============================================================================
// ICHIMOKU BASIC CALCULATION
// ============================================================================

// Tenkan-sen (Conversion Line): (9-period high + 9-period low) / 2
tenkan = donchian(tenkan_period)

// Kijun-sen (Base Line): (26-period high + 26-period low) / 2
kijun = donchian(kijun_period)

// Senkou Span A (Leading Span A): (Tenkan-sen + Kijun-sen) / 2
senkou_span_a = math.avg(tenkan, kijun)

// Senkou Span B (Leading Span B): (52-period high + 52-period low) / 2
senkou_span_b = donchian(senkou_span_b_period)

// Chikou Span (Lagging Span): Close plotted 26 periods in the past
chikou = close

// ============================================================================
// ADDITIONAL KIJUN LINES CALCULATION
// ============================================================================

kijun_65 = donchian(kijun_65_period)
kijun_129 = donchian(kijun_129_period)
kijun_172 = donchian(kijun_172_period)
kijun_234 = donchian(kijun_234_period)

// ============================================================================
// SMMA CALCULATION
// ============================================================================

smma_52 = smma(close, smma_52_period)
smma_139 = smma(close, smma_139_period)
smma_400 = smma(close, smma_400_period)

// ============================================================================
// SIGNAL CALCULATION
// ============================================================================

// Bullish Conditions
tenkan_kijun_bullish = ta.crossover(tenkan, kijun)
price_above_cloud = close > senkou_span_a[displacement] and close > senkou_span_b[displacement]

// Bearish Conditions
tenkan_kijun_bearish = ta.crossunder(tenkan, kijun)
price_below_cloud = close < senkou_span_a[displacement] and close < senkou_span_b[displacement]

// Signals
buy_signal = tenkan_kijun_bullish and price_above_cloud
sell_signal = tenkan_kijun_bearish and price_below_cloud

// ============================================================================
// PLOTTING
// ============================================================================

// Plot Basic Ichimoku
plot(show_basic_ichimoku ? tenkan : na, "Tenkan-sen", color=color.red, linewidth=1)
plot(show_basic_ichimoku ? kijun : na, "Kijun-sen", color=color.blue, linewidth=1)

// Plot Senkou Span (Cloud)
p1 = plot(show_basic_ichimoku ? senkou_span_a[displacement] : na, "Senkou Span A", color=color.green, offset=displacement)
p2 = plot(show_basic_ichimoku ? senkou_span_b[displacement] : na, "Senkou Span B", color=color.red, offset=displacement)
fill(p1, p2, color=show_basic_ichimoku ? (senkou_span_a > senkou_span_b ? color.new(color.green, 90) : color.new(color.red, 90)) : na, title="Kumo (Cloud)")

// Plot Chikou Span
plot(show_basic_ichimoku ? chikou : na, "Chikou Span", color=color.purple, linewidth=1, offset=-displacement)

// Plot Additional Kijun Lines
plot(show_additional_kijun ? kijun_65 : na, "Kijun 65", color=color.black, linewidth=2)
plot(show_additional_kijun ? kijun_129 : na, "Kijun 129", color=color.blue, linewidth=2)
plot(show_additional_kijun ? kijun_172 : na, "Kijun 172", color=color.green, linewidth=2)
plot(show_additional_kijun ? kijun_234 : na, "Kijun 234", color=color.orange, linewidth=2)

// Plot SMMA Lines
plot(show_smma ? smma_52 : na, "SMMA 52", color=color.rgb(255, 0, 255), linewidth=2, style=plot.style_line)
plot(show_smma ? smma_139 : na, "SMMA 139", color=color.rgb(0, 255, 255), linewidth=2, style=plot.style_line)
plot(show_smma ? smma_400 : na, "SMMA 400", color=color.rgb(255, 255, 0), linewidth=2, style=plot.style_line)

// Plot Buy/Sell Signals
plotshape(show_signals and buy_signal, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(show_signals and sell_signal, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.normal)

// Alert Conditions
alertcondition(buy_signal, title="Buy Signal", message="Ichimoku Buy Signal: Tenkan crossed above Kijun with price above cloud")
alertcondition(sell_signal, title="Sell Signal", message="Ichimoku Sell Signal: Tenkan crossed below Kijun with price below cloud")
